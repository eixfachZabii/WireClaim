@startuml
title WireClaim — one Game, end to end (status quo)

skinparam backgroundColor #FFFFFF
skinparam defaultFontName Helvetica
skinparam sequenceMessageAlign center
skinparam ParticipantPadding 12
skinparam BoxPadding 8

actor "Tournament\nschedule" as Sched
participant "main.run_game" as Run
participant "case_loader" as Loader
participant "RunManager" as RM
participant "SubmissionCoordinator" as SC
participant "fast_path\n.llm_values" as FP
participant "StrategyRouter" as SR
participant "fraud_detection" as FD
database "QuantCo API" as API

Sched -> Run : start_time reached\ndeadline = now + 60s

group Load (blocking — nothing can submit before this)
  Run -> Loader : load_case(game_id, deadline)
  Loader -> API : GET /api/games/{id}/key
  API --> Loader : decryption_key
  Loader -> Loader : 7z x  →  policy.txt, description.txt,\ninvoices.pdf, photo.jpg
  Loader --> Run : CaseData
end

Run -> RM : RunManager(standard_values(case))
note right of RM
  Base layer, always present:
  charge = 100 x qty
  limit  =  75 x qty
end note

Run -> SC : start()
Run -> RM : snapshot()
RM --> SC : publish(prices)
SC -> API : **PUT submissions**  (T+~0s)
note over SC : never dark from here on

par three tasks race the deadline
  Run -> FP : llm_values(case)
  FP -> FP : one LLM call, 20s timeout\n(PDF + images + policy + rules)
  FP --> Run : Proposal(source: fast_path_llm)
else
  Run -> SR : start_strategies(case)
  SR -> SR : strategy1 (35s) || strategy2 (stub)
  SR --> Run : Proposal, best **priority** wins\nstrategy2=2 > strategy1=1
else
  Run -> FD : detect_fraud(case)
  FD -> FD : one LLM call **per Line Item**, 15s\nverdict needs a verbatim policy quote
  FD --> Run : FraudDecision(fraud_indices)
end

loop each event, until deadline
  Run -> RM : set_fast_path / set_strategy / apply_fraud
  Run -> RM : snapshot()
  RM --> SC : publish(prices)
  alt prices changed
    SC -> API : **PUT submissions** (overwrite; last write wins)
  else unchanged
    SC -> SC : skip — signature identical
  end
end

Run -> SC : close()
@enduml
