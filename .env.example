# ==============================================================================
# WireClaim / Claim-to-Fame Environment Configuration Template
# Copy this file to '.env' and fill in your team credentials and API keys:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# QuantCo Tournament API Credentials (REQUIRED)
# ------------------------------------------------------------------------------
# Your team's unique and confidential API key provided by the organizers.
# Used in the 'X-API-Key' HTTP header to list games, fetch decryption keys, and submit prices.
TEAM_API_KEY=your_team_api_key_here

# Base URL for the competition backend
BASE_URL=https://c2f.public.quantco.cloud

# ------------------------------------------------------------------------------
# Azure OpenAI / OpenAI Credentials (REQUIRED for LLM analysis & pricing)
# ------------------------------------------------------------------------------
AZURE_OPENAI_API_KEY=your_azure_openai_api_key_here
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_MODEL=gpt-5.6-terra

# Optional fallback standard OpenAI API Key
OPENAI_API_KEY=your_openai_api_key_here

# ------------------------------------------------------------------------------
# Local Paths & Runtime Settings
# ------------------------------------------------------------------------------
# Directory containing encrypted case zips and extracted case folders
CASES_DIR=cases

# Logging verbosity: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
