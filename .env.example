# WireClaim / Claim-to-Fame environment configuration template.
# Copy to .env if your process manager loads it, or export these variables.

# Required for authenticated EHL schedule and key requests. Keep this secret.
TEAM_API_KEY=

# Optional overrides.
WIRECLAIM_BASE_URL=https://c2f.public.quantco.cloud
WIRECLAIM_ARCHIVE_DIR=[PUBLIC] EHL Cases/cases
WIRECLAIM_RUNTIME_DIR=var
WIRECLAIM_PROCESSOR=wireclaim.pipeline.placeholder:process_case
WIRECLAIM_SCHEDULE_REFRESH_SECONDS=15
WIRECLAIM_KEY_RETRY_SECONDS=10
WIRECLAIM_GAME_DURATION_SECONDS=60
WIRECLAIM_7Z_EXECUTABLE=7z

# Logging verbosity is currently controlled by the CLI's --verbose flag.
