# Credentials — TEAM_API_KEY lets anyone trade on our behalf. Never commit.
.env
.env.*
*.key
secrets/

# Case material: encrypted archives and their decrypted contents
cases/
data/cases/
*.zip

# Tournament state written at runtime
data/runs/
data/price_memory*.json
# ...except the committed Price Memory store. It is derived from public settled Games, so
# it is reproducible, but it has to travel with the code: whoever runs the tournament is
# not the person who built it, and an absent store makes the memory channel silently empty
# rather than loudly broken. Rebuild with `scripts/build_price_memory.py` as Games settle.
!data/price_memory.json
*.sqlite
*.db

# Tooling noise
.playwright/
__pycache__/
*.py[cod]
$py.class
.venv/
venv/
env/
.pixi/
.pytest_cache/
.DS_Store

# Distribution / packaging
build/
dist/
*.egg-info/

# IDEs
.idea/
.vscode/
*.swp
*.swo

# Tooling state that is not ours to track
.impeccable/
# Testing
.ruff_cache/

# Runtime state and decrypted case material must stay local.
var/*
!var/cases/
var/cases/*

# The same stores, reached from anywhere else. `pull_transactions.py` used a cwd-relative
# `Path("var/transactions")`, so a caller running from `scripts/` forked the whole cache into
# `scripts/var/` -- and 862 of those files were then committed, because the rule above only
# covers `var/` at the root. The path is anchored to the repository root now; this is the
# belt to that braces.
scripts/var/
**/var/transactions/
**/var/cases/
!var/cases/.gitkeep

# ...except the learning-loop record, which is the benchmarking corpus and is small.
# Together these say, per settled Game: what we estimated and why (`decisions`), what
# actually happened and which stage was wrong (`lessons`), what the reviewer made of it
# (`reviews`), and what the model literally replied (`ai_log`). About 800 KB in total.
#
# Everything else under `var/` stays out on purpose and is regenerable: `transactions/` is
# 35 MB of cached *public* leaderboard rows (`scripts/pull_transactions.py` refetches them),
# and `cases/` is 106 MB of decrypted Case material, which must never be committed -- it is
# derivable from the archives plus a released key and is not ours to publish.
!var/decisions/
# ...but not test artefacts. A real Game id is three digits; the suite's fixtures use four
# so they can never collide with a settled Game's record (see tests/test_strategy2.py).
var/decisions/game_[0-9][0-9][0-9][0-9].json
!var/lessons/
!var/reviews/
!var/ai_log/
!var/export/

# case_analysis raw leaderboard pulls (regenerable via case_analysis/fetch_data.py)
case_analysis/data/raw/

